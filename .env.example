# ─── App ────────────────────────────────────────────────────────────────────
# Application name (used in page titles, etc.)
VITE_APP_NAME=Nala

# ─── API ─────────────────────────────────────────────────────────────────────
# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# ─── Formatting ───────────────────────────────────────────────────────────────
# Default locale used by formatters (date, number, currency, relative time)
# Examples: en-US | id-ID | de-DE | ja-JP | fr-FR
VITE_DEFAULT_LOCALE=en-US

# Default currency for formatCurrency() when no currency option is passed
# Examples: USD | IDR | EUR | JPY | GBP
VITE_DEFAULT_CURRENCY=USD

# Default timezone for date/time formatters
# Indonesia: Asia/Jakarta (WIB) | Asia/Makassar (WITA) | Asia/Jayapura (WIT)
# Global: UTC | America/New_York | Europe/London | Asia/Tokyo
VITE_DEFAULT_TIMEZONE=Asia/Jakarta

# Default time format (clock system)
# '24h' (14:30) | '12h' (02:30 PM) | 'auto' (determined by locale)
VITE_DEFAULT_TIME_FORMAT=24h


