{
  "name": "nala-monorepo",
  "version": "3.0.2",
  "private": true,
  "description": "Nala — Enterprise Admin Dashboard Template & Scaffolding Tool Monorepo.",
  "author": "candrasp",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nala/showcase dev",
    "build": "pnpm --filter @nala/showcase build",
    "preview": "pnpm --filter @nala/showcase preview",
    "test": "pnpm --filter @nala/showcase test",
    "test:run": "pnpm --filter @nala/showcase test:run",
    "build:cli": "pnpm --filter create-nala build",
    "sync:ui": "powershell -Command \"Copy-Item -Recurse -Force packages/showcase/src/components/ui packages/create-nala/template/src/components/\""
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "vue-demi",
      "esbuild"
    ]
  }
}
